# Профиль clang-tidy проекта. Запуск — docs/TESTING.md, раздел
# "Статический анализ": заголовки ESP-IDF clang под хост разобрать не
# может, поэтому анализ идёт с нативными фейками из test/native/support.
#
# Отключено сознательно:
#   readability-implicit-bool-conversion — идиома Arduino и всего
#     проекта: if (autopilot), if (!imu) для nullable-зависимостей;
#   bugprone-easily-swappable-parameters — конструкторы и формулы с
#     несколькими float подряд (углы, скорости) — это норма предметной
#     области;
#   сужение int -> float (WarnOnIntegerToFloatingPointNarrowingConversion)
#     — отсчёты АЦП, время в мкс и счётчики переводятся во float
#     намеренно; сужение double -> float и целых остаётся включённым.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-member-init,
  misc-const-correctness,
  misc-definitions-in-headers,
  misc-include-cleaner,
  misc-misplaced-const,
  misc-redundant-expression,
  misc-throw-by-value-catch-by-reference,
  misc-unused-*,
  modernize-redundant-void-arg,
  modernize-use-equals-default,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-duplicate-include,
  readability-inconsistent-declaration-parameter-name,
  readability-make-member-function-const,
  readability-misleading-indentation,
  readability-non-const-parameter,
  readability-redundant-*,
  readability-static-accessed-through-instance
HeaderFilterRegex: '(include|src)/.*'
CheckOptions:
  - key: bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion
    value: false
  - key: cppcoreguidelines-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion
    value: false
